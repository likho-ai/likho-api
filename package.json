{
  "name": "likho-api",
  "version": "0.5.2",
  "description": "Likho API: login, workspaces, recordings, jobs and live lines; GraphQL for the web apps, REST for scripts and connectors",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "oxlint src/ test/ && prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run && git diff --exit-code -- schema.graphql",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "export": "nest build && node dist/tools/export.js",
    "users:add": "node dist/tools/cli.js users:add"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-node": "^2.2.0",
    "@likho-ai/contracts": "https://github.com/likho-ai/likho-contracts/releases/download/v0.7.0/likho-ai-contracts-0.7.0.tgz",
    "@nestjs/apollo": "^14.0.3",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/graphql": "^14.0.3",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
    "@opentelemetry/exporter-prometheus": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie": "^1.0.2",
    "drizzle-orm": "^0.45.1",
    "graphql": "^16.11.0",
    "ioredis": "^6.0.0",
    "nats": "^2.29.3",
    "nodemailer": "10.0.14",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.2",
    "@swc/core": "^1.16.13",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^7.0.0",
    "drizzle-kit": "^0.31.11",
    "eventsource": "^5.1.2",
    "openapi-to-postmanv2": "^6.3.3",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "supertest": "^7.3.1",
    "typescript": "^6.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.2"
  }
}

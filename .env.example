# The service reads these from the environment. The defaults match the likho-infra local stack.

LIKHO_ENV=development
LOG_LEVEL=info
HTTP_PORT=4000

DATABASE_URL=postgres://likho_api:likho_api@localhost:5433/likho_api
REDIS_URL=redis://localhost:6380
NATS_URL=nats://localhost:4222

MEDIA_GRPC_ADDR=localhost:5010
TRANSCRIPTION_GRPC_ADDR=localhost:5020
LANGUAGE_GRPC_ADDR=localhost:5030

# The address browsers use (the gateway). Cookies are marked Secure when it is https.
PUBLIC_ORIGIN=http://localhost:8080
# Keys sessions and API keys. Must be set to a long random value in production.
SESSION_SECRET=likho-dev-session-secret
SESSION_DAYS=30

# The first admin and workspace, created on the first start when there are no users yet.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-password
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_WORKSPACE_NAME=Likho

# Take events from the bus. false runs only the API (another instance takes the events).
CONSUMERS_ENABLED=true
CONSUMER_GROUP=likho-api

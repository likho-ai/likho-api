# Committed: no secrets here. Secrets for this environment live in .env.development.local (ignored by
# git; made by likho-infra/scripts/make-env-secrets.py) or in Kubernetes Secrets (likho-deploy).
# Read order: .env, .env.local, .env.development, .env.development.local; a real environment variable wins.

LIKHO_ENV=development
LOG_LEVEL=info
HTTP_PORT=4000

# The likho-infra local stack
DATABASE_URL=postgres://likho_api:likho_api@localhost:5433/likho_api
REDIS_URL=redis://localhost:6380
NATS_URL=nats://localhost:4222
MEDIA_GRPC_ADDR=localhost:5010
TRANSCRIPTION_GRPC_ADDR=localhost:5020
LANGUAGE_GRPC_ADDR=localhost:5030
SEARCH_GRPC_ADDR=localhost:5040
IMPORT_SOURCE=ameyo

PUBLIC_ORIGIN=http://localhost:8080
SESSION_SECRET=likho-dev-session-secret
SESSION_DAYS=30

# Mail (invitations, password resets). Empty: nothing is sent; invitation links are shown to the
# admin to pass on. A real server goes in .env.development.local, e.g. smtp://user:pass@host:587
SMTP_URL=
MAIL_FROM=Likho <likho@localhost>

# The first admin and workspace, created on the first start when there are no users.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=admin-password-1
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_WORKSPACE_NAME=Likho

CONSUMERS_ENABLED=true
CONSUMER_GROUP=likho-api

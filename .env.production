# Committed: no secrets here. Secrets for this environment live in .env.production.local (ignored by
# git; made by likho-infra/scripts/make-env-secrets.py) or in Kubernetes Secrets (likho-deploy).
# Read order: .env, .env.local, .env.production, .env.production.local; a real environment variable wins.

LIKHO_ENV=production
LOG_LEVEL=info
HTTP_PORT=4000

# DATABASE_URL, SESSION_SECRET, BOOTSTRAP_ADMIN_EMAIL, BOOTSTRAP_ADMIN_PASSWORD and
# PUBLIC_ORIGIN (the public domain): in .env.production.local
REDIS_URL=redis://redis:6379
NATS_URL=nats://nats:4222
MEDIA_GRPC_ADDR=likho-media:5010
TRANSCRIPTION_GRPC_ADDR=likho-transcription:5020
LANGUAGE_GRPC_ADDR=likho-language:5030
SEARCH_GRPC_ADDR=likho-search:5040
IMPORT_SOURCE=ameyo

SESSION_DAYS=30
# SMTP_URL and MAIL_FROM (invitations and password resets by mail): in .env.production.local.
# While SMTP_URL is empty, admins pass invitation links on by hand.
BOOTSTRAP_ADMIN_NAME=Admin
BOOTSTRAP_WORKSPACE_NAME=Likho

CONSUMERS_ENABLED=true
CONSUMER_GROUP=likho-api

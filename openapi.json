  "info": {
    "title": "Likho API",
    "description": "Recordings, jobs and transcripts for scripts and connectors. Browsers use /graphql.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "The local gateway"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "An API key from the settings page (lk_...)"
      }
    },
    "schemas": {
      "RequestUploadDto": {
        "type": "object",
        "properties": {
          "originalName": {
            "type": "string",
            "example": "call-2026-10-01-0912.mp3"
          },
          "sizeBytes": {
            "type": "number",
            "example": 105000
          },
          "contentType": {
            "type": "string",
            "example": "audio/mpeg"
          },
          "sha256": {
            "type": "string",
            "description": "When known, the same content is not uploaded twice."
          },
          "externalId": {
            "type": "string",
            "description": "Your own id for the call."
          },
          "source": {
            "type": "string",
            "description": "Where the call comes from: a connector’s name, e.g. ameyo.",
            "example": "ameyo"
          },
          "attributes": {
            "type": "object",
            "description": "Facts about the call: campaign, agent, disposition, call time, ...",
            "example": {
              "campaign": "inbound",
              "agent": "agent-12",
              "disposition": "sale"
            }
          }
        },
        "required": [
          "originalName",
          "sizeBytes"
        ]
      },
      "CorrectSegmentDto": {
        "type": "object",
        "properties": {
          "transcriptId": {
            "type": "string",
            "description": "The version being looked at; it must be the latest."
          },
          "segmentIndex": {
            "type": "number",
            "example": 3
          },
          "layer": {
            "type": "string",
            "enum": [
              "script",
              "roman"
            ],
            "description": "script: as spoken, in its script. roman: the Hinglish."
          },
          "text": {
            "type": "string",
            "description": "What the line should read."
          }
        },
        "required": [
          "transcriptId",
          "segmentIndex",
          "layer",
          "text"
        ]
      },
      "CreateJobDto": {
        "type": "object",
        "properties": {
          "modelRegistryId": {
            "type": "string",
            "description": "Empty = the default model."
          },
          "languagePolicy": {
            "type": "string",
            "description": "\"auto\" or a language code.",
            "example": "auto"
          },
          "force": {
            "type": "boolean"
          }
        }
      },
      "RequestImportDto": {
        "type": "object",
        "properties": {
          "externalId": {
            "type": "string",
            "description": "The call’s id in the dialer (its crt_object_id).",
            "example": "d000-0a1b2c3d-vce-0001"
          },
          "source": {
            "type": "string",
            "description": "Which connector; empty = the default one."
          },
          "transcribe": {
            "type": "boolean",
            "description": "Transcribe once stored (default true)."
          }
        },
        "required": [
          "externalId"
        ]
      },
      "AnalyseDto": {
        "type": "object",
        "properties": {
          "force": {
            "type": "boolean",
            "description": "Analyse again even when the recording has insights."
          }
        }
      },
      "ExchangeDto": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "description": "Who is looking, in the other system’s own terms (its user); kept for the audit log."
          },
          "ttlSeconds": {
            "type": "number",
            "description": "How long the token lives: 60 to 3600 seconds (default 900)."
          }
        }
      }
    }
  }
}

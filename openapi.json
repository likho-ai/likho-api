    "/api/v1/search": {
      "get": {
        "description": "A few words in either layer, typos allowed; the matches are inside <mark>…</mark>.",
        "operationId": "SearchController_find",
        "parameters": [
          {
            "name": "q",
            "required": true,
            "in": "query",
            "description": "A few words, in either layer; typos allowed.",

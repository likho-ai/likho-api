    "/api/v1/recordings": {
      "post": {
        "description": "Makes the recording and returns the link to PUT the file to.",
        "operationId": "RecordingsController_requestUpload",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestUploadDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Start an upload",
        "tags": [
          "recordings"
        ]
      },
      "get": {
        "description": "Newest first.",
        "operationId": "RecordingsController_list",
        "parameters": [
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "uploading",
                "uploaded",
                "ready",
                "failed",
                "queued",
                "transcribing",
                "done"
              ]
            }
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "after",
            "required": false,
            "in": "query",
            "description": "The id of the last recording of the previous page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "first",
            "required": false,
            "in": "query",
            "schema": {
              "default": 50,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List recordings",
        "tags": [
          "recordings"
        ]
      }
    },

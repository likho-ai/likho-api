  "info": {
    "title": "Likho API",
    "description": "Recordings, jobs and transcripts for scripts and connectors. Browsers use /graphql.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "The local gateway"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "An API key from the settings page (lk_...)"
      }
    },
    "schemas": {
      "RequestUploadDto": {
        "type": "object",
        "properties": {
          "originalName": {
            "type": "string",
            "example": "call-2026-10-01-0912.mp3"
          },
          "sizeBytes": {
            "type": "number",
            "example": 105000
          },
          "contentType": {
            "type": "string",
            "example": "audio/mpeg"
          },
          "sha256": {
            "type": "string",
            "description": "When known, the same content is not uploaded twice."
          },
          "externalId": {
            "type": "string",
            "description": "Your own id for the call."
          }
        },
        "required": [
          "originalName",
          "sizeBytes"
        ]
      },
      "CreateJobDto": {
        "type": "object",
        "properties": {
          "modelRegistryId": {
            "type": "string",
            "description": "Empty = the default model."
          },
          "languagePolicy": {
            "type": "string",
            "description": "\"auto\" or a language code.",
            "example": "auto"
          },
          "force": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
